{
  "name": "memory-universe-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Memory Universe desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev:debug": "npm run build && cross-env ELECTRON_START_URL=http://localhost:5173 electron . --remote-debugging-port=9222",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.memoryuniverse.desktop",
    "productName": "Memory Universe",
    "directories": {
      "output": "release"
    },
    "artifactName": "Memory-Universe-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Memory Universe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
